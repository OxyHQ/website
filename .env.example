# Copy to `.env` and fill in. Secrets are listed with no value on purpose:
# nothing in this file is a credential, and nothing here is committed with one.
#
# In production these are GitHub Actions repo secrets, synced to SSM under
# /oxy/website-api/<NAME> by .github/workflows/deploy-aws.yml and attached to
# the ECS task in ~/Oxy/oxy-infra (terraform-uswest2/app-services.tf). A name
# added here that the task definition does not reference will never reach the
# running service.

# ── Server ──
PORT=4000
OXY_API_BASE=https://api.oxy.so
CORS_ORIGIN=http://localhost:5173
SITE_URL=https://oxy.so
DEFAULT_LOCALE=en
# Oxy user ids allowed into /admin. Not secret, an allow-list. Comma separated.
OXY_ADMIN_USER_IDS=

# ── GitHub ──
# Read-only. Lifts the anonymous rate limit on the changelog release sync.
GITHUB_TOKEN=

# ── Feature board ──
# Writes: opens issues from the proposal form and sets the priority labels.
# Needs `issues: write` on every org the board covers (OxyHQ and
# FairCoinOfficial today; the board's org list is TrackedRepo rows, not code).
# A fine-grained token needs Issues: Read and write; a classic one needs `repo`
# for private repos or `public_repo` for public ones only.
# Deliberately not named GITHUB_*: GitHub reserves that prefix for Actions
# secrets, so a GITHUB_-prefixed name could never be provisioned as a repo
# secret. Without it the board still lists and still counts votes; proposals
# answer 503 and the priority reconcile does not run.
FEATURE_BOARD_GITHUB_TOKEN=

# Durable per-user proposal quota, counted in Postgres.
FEATURE_PROPOSAL_LIMIT=5
FEATURE_PROPOSAL_WINDOW_HOURS=24
# In-process burst guard, per user, in front of that quota.
FEATURE_PROPOSAL_BURST_PER_MINUTE=2

# How often the priority labels are reconciled against the vote counts.
FEATURE_PRIORITY_RECONCILE_MINUTES=60
# Compute the label changes and report them without writing to GitHub.
FEATURE_PRIORITY_DRY_RUN=false
# Override the priority tiers. JSON array, ascending by enterAt, each entry
# { key, label, color, description, enterAt, exitAt } with exitAt below enterAt
# (the gap is the hysteresis band). Unset uses the built-in table:
# medium 10/7, high 25/18, critical 50/38. A malformed value fails at boot.
FEATURE_PRIORITY_TIERS=

# ── Media (S3 / CloudFront) ──
AWS_REGION=us-west-2
AWS_S3_BUCKET=
AWS_S3_KEY_PREFIX=public/
CDN_BASE_URL=https://cloud.oxy.so
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only for an S3-compatible provider that is not AWS.
AWS_ENDPOINT_URL=

# ── Infrastructure status widget ──
DO_API_TOKEN=

# ── Frontend (Vite, baked into the bundle at build time) ──
VITE_API_URL=http://localhost:4000
VITE_OXY_API=https://api.oxy.so
VITE_OXY_CLIENT_ID=
VITE_FAIRCOIN_EXPLORER_URL=
VITE_FAIRCOIN_BRIDGE_URL=
VITE_WALLETCONNECT_PROJECT_ID=
