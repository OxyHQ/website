# FedCM IdP well-known. Chrome fetches this from the eTLD+1 (oxy.so) to
# validate the IdP config at https://auth.oxy.so/fedcm.json. It MUST be
# served as application/json, otherwise FedCM rejects the IdP and
# navigator.credentials.get() throws NetworkError before any UI shows —
# breaking login on accounts.oxy.so and every Oxy app.
/.well-known/web-identity
  Content-Type: application/json
  Cache-Control: public, max-age=300, must-revalidate

# Static assets are content-hashed, but they must NOT be cached `immutable`.
# The SPA catch-all (`/*  /index.html  200`) serves index.html (200, HTML) for
# any asset URL that briefly 404s during a deploy's edge propagation, and an
# `immutable, max-age=31536000` header then freezes that HTML under a `.js` URL
# for a year — a poisoned entry that blanks the whole app and cannot be purged
# without dashboard access. `no-cache` still stores the file but revalidates it
# against origin on every use, so a poisoned entry self-heals on the next
# request instead of persisting. Revalidation of an unchanged hashed file is a
# cheap 304.
/assets/*
  Cache-Control: public, no-cache

# Cache images
/images/*
  Cache-Control: public, max-age=2592000

# Cache fonts
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML — always revalidate so browsers pick up new asset hashes after deploys
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Security headers
#
# The script-src below carries a placeholder token, not literal hashes.
# `scripts/build-csp-headers.ts` runs in `postbuild`, reads the inline <script>
# blocks out of the built `dist/index.html`, and substitutes their real sha256
# hashes. Hand-written hashes would be a trap: editing an inline script without
# remembering to update the header blocks it at the edge, and the failure mode
# is a blank page in production with a console error nobody sees until a user
# reports it. Deriving them from the artifact makes that impossible.
#
# The token is deliberately not spelled out in this comment — it must appear
# exactly once in this file so the build can detect an unsubstituted header.
#
# Deliberately permissive where it has to be:
#   style-src 'unsafe-inline'  — react-native-web writes inline styles at runtime
#   connect-src https: wss:    — wallet RPC + WalletConnect relays are user-chosen
#   img/media https:           — CMS media is served from cloud.oxy.so and elsewhere
# The value is in `script-src`: no inline script runs unless it is one of the two
# we shipped, which is the case XSS actually needs.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
